# Cloudflare Pages response headers.
# Keep connect-src in step with worker.js: the worker reads the newest version off
# the PyPI JSON API and micropip fetches the wheel from PyPI at runtime, and
# Pyodide itself comes from jsDelivr.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval' https://cdn.jsdelivr.net; worker-src 'self' blob:; connect-src 'self' https://cdn.jsdelivr.net https://pypi.org https://files.pythonhosted.org; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-src 'self' blob: data:; base-uri 'none'; form-action 'none'

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/sample/*
  Cache-Control: public, max-age=86400

/worker.js
  Cache-Control: public, max-age=0, must-revalidate
